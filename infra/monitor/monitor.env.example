# host paths, read by compose
MUTO_BACKUP_DIR=/<muto backup dir>
EVENTS_BOT_BACKUP_DIR=/<events_bot backup dir>
CLAVIS_BACKUP_DIR=/<clavis backup dir>
RESTORE_LOG_DIR=/var/log/numer

# read by monitor.sh, paths are the ones inside the container
CHECKS='gradus|https://<gradus api domain>/health/ready
clavis|https://<clavis api domain>/health/ready
events_bot|https://<events_bot api domain>/health/ready
muto|https://<muto api domain>/health/ready'
BACKUPS='muto|/backups/muto|26
events_bot|/backups/events_bot|26
clavis|/backups/clavis|26'
RESTORE_LOG=/restore-log/restore-tests.log
RESTORE_NAMES='muto events_bot clavis'
RESTORE_MAX_AGE_DAYS=8
ALERT_WEBHOOK_URL=https://<webhook domain>/<webhook path>
HEARTBEAT_URL=https://<heartbeat domain>/<ping path>
INTERVAL_SECONDS=60
REPEAT_HOURS=6
