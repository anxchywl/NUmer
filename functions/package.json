{
  "name": "numer-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-numer \"jest --config jest.emulator.config.js --runInBand\"",
    "mail:test": "node scripts/send_test_email.js",
    "deploy": "firebase deploy --only functions",
    "start": "firebase emulators:start --only functions,firestore",
    "roles:set": "tsc && node scripts/set_roles.js",
    "backfill": "node scripts/backfill.js",
    "backfill:email": "FORCE_BACKFILL=1 node scripts/backfill_email_index.js",
    "backfill:group-index": "node scripts/backfill_group_index.js",
    "backfill:public-profiles": "npm run build && node scripts/backfill_public_profiles.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "30.0.0",
    "firebase-functions-test": "3.5.0",
    "firebase-tools": "15.37.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "^5.0.0"
  }
}
