APPCHECK_ENFORCED=
# on (default) makes the five email code callables reject calls without an app check token
AUTH_ENFORCE_APPCHECK=on
MAIL_FROM=NUmer <no-reply@mail.anxchywl.dev>
MAIL_PROVIDER=resend
# study aggregates: on runs the incremental ledger path, off (default) the legacy recompute
AGG_INCREMENTAL=off
# off mode only: percent of users (0 to 100, default 0) whose events are also run through the private ledger and compared
AGG_SHADOW_PERCENT=0
# on makes deleteAccountCallable require a sign-in from the last 5 minutes; off (default) until every app version re-authenticates
DELETE_REQUIRES_RECENT_AUTH=off
# JSON list of {"module": "clavis" | "events" | "muto", "url": ...} that receive account events (https only); each listed module needs its secret ACCOUNT_EVENTS_SECRET_<MODULE> before deploy
ACCOUNT_EVENT_TARGETS=[]
