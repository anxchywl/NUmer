
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isUserGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/groupMemberships/$(groupId));
    }

    function groupIndexPath(userId) {
      return /databases/$(database)/documents/groupIndex/$(userId);
    }

    function indexedGroupIds(userId) {
      return exists(groupIndexPath(userId)) ? get(groupIndexPath(userId)).data.groupIds : [];
    }

    function hasSharedGroup(userId) {
      return isSignedIn() &&
        indexedGroupIds(request.auth.uid) is list &&
        indexedGroupIds(userId) is list &&
        indexedGroupIds(request.auth.uid).hasAny(indexedGroupIds(userId));
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupCreator(groupId) {
      return isSignedIn() && groupExists(groupId) && groupData(groupId).createdBy == request.auth.uid;
    }

    function isGroupPublic(groupId) {
      return groupExists(groupId) &&
        (!('visibility' in groupData(groupId)) || groupData(groupId).visibility == 'public');
    }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function memberCountStep() {
      let before = ('memberCount' in resource.data) ? resource.data.memberCount : 0;
      let after = ('memberCount' in request.resource.data) ? request.resource.data.memberCount : before;
      return after == before || after == before + 1 || after == before - 1 || (before <= 1 && after == 0);
    }

    function validSessionWrite() {
      let d = request.resource.data;
      return !('seconds' in d) || (d.seconds is number && d.seconds >= 0 && d.seconds <= 604800);
    }

    function isGroupAdmin(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)) && (
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isCreatingGroupAsOwner(groupId) {
      return isSignedIn() &&
             !exists(/databases/$(database)/documents/groups/$(groupId)) &&
             existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
             getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function isMemberSelfUpdatingCount(groupId) {
      return isSignedIn() &&
             request.resource.data.updatedAt == request.time &&
             request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberCount', 'updatedAt']) &&
             (
               // Leaving: membership existed before and is deleted in this request
               (
                 exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
                 !existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
               ) ||
               // Joining: membership created in this request
               (
                 !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
                 existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
               )
             );
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource == null ||
        !('visibility' in resource.data) ||
        resource.data.visibility == 'public' ||
        isGroupMember(groupId) ||
        isGroupAdmin(groupId)
      );
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['name', 'description', 'visibility', 'createdBy', 'createdAt', 'updatedAt', 'memberCount'])
        && request.resource.data.memberCount == 1;

      allow update: if isSignedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && memberCountStep()
        && (
          (isGroupAdmin(groupId)
            && affected().hasOnly(['name', 'description', 'visibility', 'updatedAt', 'memberCount']))
          || isMemberSelfUpdatingCount(groupId)
        );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isGroupMember(groupId) || isGroupAdmin(groupId) || (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
        );
        allow create: if isSignedIn() && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['role', 'joinedAt'])
          && (
            (isCreatingGroupAsOwner(groupId) && request.resource.data.role == 'admin')
            || (isGroupCreator(groupId) && request.resource.data.role in ['admin', 'member'])
            || (isGroupPublic(groupId) && request.resource.data.role == 'member')
          );
        allow update: if isGroupCreator(groupId)
          && affected().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'member'];
        allow delete: if isSignedIn() && (
          memberId == request.auth.uid
          || (isGroupAdmin(groupId) && memberId != groupData(groupId).createdBy)
        );
      }

      // Invites subcollection (if used)
      match /invites/{inviteId} {
        allow read: if isSignedIn() && (
          request.auth.uid == inviteId ||
          isGroupAdmin(groupId)
        );
        allow write: if isSignedIn() && isGroupAdmin(groupId);
      }

      // Secrets subcollection (for join codes) - Secured
      match /secrets/{secretId} {
        allow read: if isSignedIn() && isGroupAdmin(groupId);
        allow write: if isSignedIn() && (
          isGroupAdmin(groupId) ||
          // Allow join code to be written atomically while the group is being created
          isCreatingGroupAsOwner(groupId)
        );
      }

      // Aggregated study statistics per member
      match /aggregates/{memberId} {
        allow read: if isGroupMember(groupId) || isUserGroupMember(groupId) || (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
        );
        allow write: if false; // Only Cloud Functions (admin SDK) should write
        // Allow deletion if admin OR if the user is deleting their own data (leaving)
        allow delete: if isSignedIn() && (isGroupAdmin(groupId) || request.auth.uid == memberId);
      }

      // Stats and Leaderboard subcollections (requested by user)
      match /stats/{statId} {
        allow read: if isGroupMember(groupId) || isUserGroupMember(groupId) || isGroupAdmin(groupId) || (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
        );
      }
      match /leaderboard/{docId} {
        allow read: if isGroupMember(groupId) || isUserGroupMember(groupId) || isGroupAdmin(groupId) || (
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public'
        );
      }
      // Allow deletion of all subcollection documents when deleting the group (recursive delete)
      // members are excluded because rules are or-ed and this would bypass the creator guard
      match /{document=**} {
        allow delete: if isSignedIn() && isGroupAdmin(groupId) && document[0] != 'members';
      }
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isOwner(userId);
    }

    // Email index for password reset lookup
    match /email_index/{emailId} {
      allow get, list: if false;
      allow create, update: if isSignedIn()
        && request.auth.token.email != null
        && emailId == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // user aggregates: owner and co-members only
    match /users/{userId}/aggregates/{document=**} {
      allow read: if isOwner(userId) || hasSharedGroup(userId);
      allow write: if false; // Only Cloud Functions (admin SDK) should write
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId) || hasSharedGroup(userId);
      allow create, update: if isOwner(userId) && validSessionWrite();
      allow delete: if isOwner(userId);
    }

    // Private user data - Owner only
    match /users/{userId}/courses/{courseId} {
      // Allow peer reading if they share a group (needed for displaying course names in leaderboard details)
      allow read: if isOwner(userId) || hasSharedGroup(userId);
      allow write: if isOwner(userId);
    }

    match /users/{userId}/studySessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/studyTimes/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/courseGoals/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/courseProgress/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/goals/{goalId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/reflections/{reflectionId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/preferences/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/aiLogs/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/stats/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/meta/{documentId} {
      allow read, write: if isOwner(userId);
    }

    // User group memberships
    match /users/{userId}/groupMemberships/{groupId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(userId));
      // Allow the user to leave or an admin/creator to remove membership.
      // Also allow the creator to update roles (promote/demote)
      allow update: if request.auth != null && (
        (request.auth.uid == userId && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(userId))) ||
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId || isGroupAdmin(groupId) ||
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
      );
    }

    // Nudge cooldowns - user can read and write their own cooldowns
    match /users/{userId}/nudgeCooldowns/{cooldownId} {
      allow read, write: if isOwner(userId);
    }

    // Habits feature
    // Habits feature
    match /users/{userId}/habits/{habitId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/habits/{habitId}/history/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/habit_categories/{catId} {
      allow read, write: if isOwner(userId);
    }

    match /nudges/{nudgeId} {
      allow read: if isSignedIn() && resource.data.receiverId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.receiverId == request.auth.uid
        && affected().hasOnly(['status']) && request.resource.data.status == 'delivered';
      allow create, delete: if false;
    }

    // server-maintained mirrors and config, clients only read
    match /publicProfiles/{userId} {
      allow get: if isOwner(userId) || hasSharedGroup(userId);
      allow list, write: if false;
    }

    match /groupIndex/{userId} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    match /config/{docId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /feed/{docId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /users/{userId}/aggState/{docId} {
      allow read, write: if false;
    }

    // server only
    match /nudgeLimits/{docId} {
      allow read, write: if false;
    }

    match /joinAttempts/{docId} {
      allow read, write: if false;
    }

    match /authCodes/{docId} {
      allow read, write: if false;
    }

    match /authRateLimits/{docId} {
      allow read, write: if false;
    }

    match /mailQueue/{docId} {
      allow read, write: if false;
    }

    match /authAudit/{docId} {
      allow read, write: if false;
    }

    match /deletedUsers/{docId} {
      allow read, write: if false;
    }

    match /accountEvents/{docId} {
      allow read, write: if false;
    }

    match /announcements/{docId} {
      allow read, write: if false;
    }

    // First seen times of feed events - server only
    match /feedState/{docId} {
      allow read, write: if false;
    }

    // Role change log - server only
    match /roleAudit/{entryId} {
      allow read, write: if false;
    }

    // Connections feature
    match /users/{userId}/connections/{personId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/connectionGroups/{groupId} {
      allow read, write: if isOwner(userId);
    }
  }
}
