# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

require 'fileutils'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def ensure_legacy_grpc_modulemap
  pods_root = File.join(__dir__, 'Pods')
  grpc_modulemap = File.join(pods_root, 'Target Support Files', 'gRPC-Core', 'gRPC-Core.modulemap')
  grpc_headers_prefix = '../../Headers/Private/gRPC-Core/grpc/'

  return unless File.exist?(grpc_modulemap)

  modulemap_contents = File.read(grpc_modulemap)
  rewritten_modulemap = modulemap_contents.gsub(/(umbrella header|header|textual header) "([^"]+)"/) do
    directive = Regexp.last_match(1)
    header_path = Regexp.last_match(2)
    next %(#{directive} "#{header_path}") if header_path.start_with?(grpc_headers_prefix)

    %(#{directive} "#{grpc_headers_prefix}#{header_path}")
  end

  File.write(grpc_modulemap, rewritten_modulemap) if rewritten_modulemap != modulemap_contents

  Dir.glob(File.join(pods_root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig|
    xcconfig_contents = File.read(xcconfig)
    rewritten_xcconfig = xcconfig_contents.gsub(
      '${PODS_ROOT}/Headers/Private/grpc/gRPC-Core.modulemap',
      '${PODS_ROOT}/Target Support Files/gRPC-Core/gRPC-Core.modulemap'
    )
    rewritten_xcconfig = rewritten_xcconfig.gsub(
      / -weak_framework "FirebaseFirestoreInternal"/,
      ''
    )
    File.write(xcconfig, rewritten_xcconfig) if rewritten_xcconfig != xcconfig_contents
  end
end

target 'Runner' do
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force iOS 15.0 for all pods to avoid deployment target warnings
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      
      # Fix 'Flutter/Flutter.h' not found and internal module consistency
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Additional fix for CocoaPods script sandboxing in Xcode 15+
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
  ensure_legacy_grpc_modulemap
end

post_integrate do |_installer|
  ensure_legacy_grpc_modulemap
end
